# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Recommended fast model: gemini-flash-lite-latest (responds in ~1.5 seconds)
# Note: gemini-3.8-flash has high latency (>120s) on free-tier API quotas.
GEMINI_MODEL=gemini-flash-lite-latest

# Request HTTP Timeout in seconds (default: 30)
GEMINI_TIMEOUT_SECONDS=30
